// Prisma schema for the university student/parent/staff portal
// Run `npx prisma migrate dev` after connecting a real database (Postgres recommended).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

model Faculty {
  id          String       @id @default(cuid())
  name        String       @unique
  departments Department[]
}

model Department {
  id        String    @id @default(cuid())
  name      String
  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  facultyId String
  students  Student[]
  courses   Course[]
  staff     Staff[]
  fees      Fee[]

  @@unique([name, facultyId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  student Student?
  staff   Staff?
  admin   Admin?
}

model Student {
  id           String       @id @default(cuid())
  matricNumber String       @unique
  fullName     String
  level        Int
  user         User         @relation(fields: [userId], references: [id])
  userId       String       @unique
  department   Department   @relation(fields: [departmentId], references: [id])
  departmentId String
  results      Result[]
  fees         StudentFee[]
}

model Staff {
  id           String     @id @default(cuid())
  fullName     String
  user         User       @relation(fields: [userId], references: [id])
  userId       String     @unique
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
}

model Admin {
  id       String @id @default(cuid())
  fullName String
  user     User   @relation(fields: [userId], references: [id])
  userId   String @unique
}

model Course {
  id           String     @id @default(cuid())
  code         String
  title        String
  units        Int
  semester     Semester
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  results      Result[]

  @@unique([code, departmentId])
}

enum Semester {
  FIRST
  SECOND
}

model Result {
  id         String   @id @default(cuid())
  student    Student  @relation(fields: [studentId], references: [id])
  studentId  String
  course     Course   @relation(fields: [courseId], references: [id])
  courseId   String
  session    String
  score      Int
  grade      String
  gradePoint Float
  comment    String?
  uploadedAt DateTime @default(now())

  @@unique([studentId, courseId, session])
}

model Fee {
  id           String     @id @default(cuid())
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  level        Int
  session      String
  semester     Semester
  amount       Int
  studentFees  StudentFee[]

  @@unique([departmentId, level, session, semester])
}

model StudentFee {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id])
  studentId String
  fee       Fee     @relation(fields: [feeId], references: [id])
  feeId     String
  amountPaid Int    @default(0)

  @@unique([studentId, feeId])
}

model Announcement {
  id           String   @id @default(cuid())
  title        String
  body         String
  postedByRole Role
  departmentId String?
  createdAt    DateTime @default(now())
}
